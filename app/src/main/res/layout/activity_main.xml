<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TOP BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <View android:layout_width="8dp" android:layout_height="8dp"
                android:background="#FFD700"/>
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text=" • MRIDU PAWAN CORE  v4.5"
                android:textColor="#FFD700"
                android:textSize="11sp"
                android:fontFamily="monospace"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ONLINE • ARMED"
                android:textColor="#FFD700"
                android:textSize="10sp"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- LOGO -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/alpha_logo"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"/>

        <!-- COCKPIT BADGE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ ACTIVE DEFENSE COCKPIT ⚡"
            android:textColor="#FFD700"
            android:textSize="11sp"
            android:background="@drawable/btn_dark"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_gravity="center_horizontal"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALPHA"
            android:textColor="#FFD700"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Premium"
            android:textColor="#888888"
            android:textSize="13sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"/>

        <!-- LICENSE TELEMETRY CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_dark"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="LICENSE TELEMETRY &amp; VAULT"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• ARMED"
                    android:textColor="#FFD700"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- VIP STATUS ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/input_bg"
                android:padding="10dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="■ "
                    android:textColor="#FFD700"
                    android:textSize="12sp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="VIP LICENSE STATUS"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>
                <TextView
                    android:id="@+id/tv_license_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXPIRING SOON"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- COUNTDOWN + TIMESTAMP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/input_bg"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EXPIRATION COUNTDOWN"
                        android:textColor="#555555"
                        android:textSize="9sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:id="@+id/tv_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00:59:51"
                        android:textColor="#FFD700"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/input_bg"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SESSION TIMESTAMP"
                        android:textColor="#555555"
                        android:textSize="9sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:id="@+id/tv_session_ts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="28 SEP 2026 // 19:22:52"
                        android:textColor="#888888"
                        android:textSize="11sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- LIVE SLOT TELEMETRY CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_dark"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="LIVE SLOT TELEMETRY"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
                <TextView
                    android:id="@+id/tv_slot_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE SLOTS -- / 10"
                    android:textColor="#FFD700"
                    android:textSize="10sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- Slot bars -->
            <LinearLayout
                android:id="@+id/ll_slots"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waiting for live server slot telemetry..."
                android:textColor="#444444"
                android:textSize="11sp"
                android:fontFamily="monospace"/>

        </LinearLayout>

        <!-- SYSTEM & KERNEL SPECS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_dark"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM &amp; KERNEL SPECS"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE SPECS"
                    android:textColor="#FFD700"
                    android:textSize="10sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/input_bg"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• DEVICE PLATFORM"
                        android:textColor="#555555"
                        android:textSize="9sp"
                        android:fontFamily="monospace"/>
                    <TextView
                        android:id="@+id/tv_device_model"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MODEL - LOADING"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/input_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• ANDROID BUILD"
                        android:textColor="#555555"
                        android:textSize="9sp"
                        android:fontFamily="monospace"/>
                    <TextView
                        android:id="@+id/tv_android_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ANDROID VERSION - 0"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"/>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/input_bg"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• RAM ALLOCATION"
                        android:textColor="#555555"
                        android:textSize="9sp"
                        android:fontFamily="monospace"/>
                    <TextView
                        android:id="@+id/tv_ram"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RAM - 0 GB"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/input_bg"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• CORE STATUS"
                        android:textColor="#555555"
                        android:textSize="9sp"
                        android:fontFamily="monospace"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ONLINE"
                        android:textColor="#FFD700"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- LAUNCH FLOATING PANEL BUTTON -->
        <Button
            android:id="@+id/btn_launch_panel"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="LAUNCH FLOATING PANEL"
            android:background="@drawable/btn_gold"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"/>

    </LinearLayout>
</ScrollView>